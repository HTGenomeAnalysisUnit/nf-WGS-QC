    ht_cluster {
        workDir = "/scratch/$USER/nf-work"
        conda.enabled = true
        process {
            errorStrategy = 'retry'
            maxRetries = 5
            //DEFINE RESOURCES
            withLabel: small_on_local {
                executor = 'local'
                maxForks = params.max_local_processes
            }
            withName: 'BCFTOOLS_INDEX' {
                cpus = 1
                memory = 1.GB
            }
            withName: 'RUN_ALIGNEMENTS_QC:COMPUTE_READSTATS' {
                cpus = 1
                memory = 24.GB
            }
            withName: 'RUN_ALIGNEMENTS_QC:COUNT_BASES' {
                cpus = 1
                memory = 1.GB
            }
            withName: 'RUN_ALIGNEMENTS_QC:COVERAGE' {
                cpus = 8
                memory = 4.GB
            }
            withName: 'RUN_ALIGNEMENTS_QC:SAMTOOLS_STATS' {
                cpus = 8
                memory = 1.GB
            }
            withName: 'RUN_ALIGNEMENTS_QC:SOMALIER_EXTRACT' {
                cpus = 1
                memory = 1.GB
            }
            withName: 'RUN_VARIANTS_QC:BCFTOOLS_IDX_STATS' {
                cpus = 1
                memory = 1.GB
            }
            withName: 'RUN_VARIANTS_QC:BCFTOOLS_STATS' {
                cpus = 2
                memory = 1.GB
            }
            withName: 'RUN_VARIANTS_QC:VCF_CONTAMINATION:ANNOTATE_AF' {
                cpus = 1
                memory = 1.GB
            }
            withName: 'RUN_VARIANTS_QC:VCF_CONTAMINATION:BCFTOOLS_FILTER_NORM' {
                cpus = 1
                memory = 1.GB
            }
            withName: 'RUN_VARIANTS_QC:VCF_CONTAMINATION:COMPUTE_CHARR' {
                cpus = 1
                memory = 4.GB
            }
            withName: 'SAMTOOLS_INDEX' {
                cpus = 8
                memory = 1.GB
            }
            withName: 'MAKE_REPORTS:MAKE_REPORTS_WF:MAKE_PED' {
                cpus = 1
                memory = 1.GB
            }
            withName: 'MAKE_REPORTS:MAKE_REPORTS_WF:PREPARE_SUMMARY' {
                maxRetries = 1
                cpus = 1
                memory = 16.GB
            }
            withName: 'MAKE_REPORTS:MAKE_REPORTS_WF:SOMALIER_ANCESTRY' {
                cpus = 1
                memory = 16.GB
            }
            withName: 'MAKE_REPORTS:MAKE_REPORTS_WF:SOMALIER_RELATE' {
                cpus = 1
                memory = 16.GB
            }
            //DEFINE MODULES and CONTAINERS
            withName: GET_SAMPLE_ID_BAM {
                module = 'samtools/1.15'
            }
            withName: GET_BAM_MANIFEST {
                module = 'samtools/1.15'
            }
            withName: 'SAMTOOLS.*' {
                module = 'samtools/1.15'
            }
            withName: 'COUNT_BASES' {
                module = 'samtools/1.15'
            }
            withName: 'SOMALIER.*' {
                module = 'somalier'
            }
            withName: COVERAGE {
                module = 'mosdepth:htslib-tools/1.14'
            }
            withName: MULTIQC {
                container = "${singularity.cacheDir}/multiqc_v1.12.sif"
            }
            withName: 'QC_RMD_SMALLVARS' {
                container = "${singularity.cacheDir}/vcf_qc_report_v1.sif"
            }
            withName: PREPARE_SUMMARY {
                module = 'R/4.1.0'
            }
            withName: 'BCFTOOLS.*' {
                module = 'bcftools/1.15.1'
            }
            withName: ANNOTATE_AF {
                module = 'htslib-tools/1.14'
            }
            withName: MAKE_PED {
                conda = '/ssu/gassu/conda_envs/pythonenv_latest'
            }
        }
    }