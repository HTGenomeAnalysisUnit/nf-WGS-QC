cleanup = true

params {
    outdir = 'QC'
    project_id = 'project'
    project_metadata = null //tsv file containing internal ids, external ids and sex
    report_file     = "pipeline_report.html"
    bamfiles        = null //bam manifest file: sample, bam
    fastp_json      = null //path to fastp json results
    samblaster_log  = null //path to samblaster logs
    vcffiles        = null //vcf manifest file: sample, vcf
    vcf_index_type  = 'csi' //csi or tbi
    mode            = 'WGS' //WGS or WES
    ped_file        = null
    genome_fasta          = 'genome.fasta' //a .fai file must exist in the same location
    regions         = ''
    somalier_vars   = '' //VCF of somalier reference variants
    somalier_labels = '' //ancestry labels for 1kg sample 
    somalier_1kgdata = '' //path to a folder containing .somalier files for the 1000G data
    max_local_processes = 4
    make_summary = true
    run_multiqc = true
    by_tranche = true
    vcf_index_type = 'csi'
    make_vcf_index = false
    make_bam_index = false
    mosdepth_quantize_bins = [1,10,20,100]
}

profiles {
    singularity {
        singularity.enabled     = true
        singularity.autoMounts  = true
        conda.enabled           = false
        docker.enabled          = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
    }
    conda {
        conda.enabled           = true
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        conda.channels          = ['conda-forge', 'bioconda']
        apptainer.enabled       = false
    }
    mamba {
        conda.enabled           = true
        conda.useMamba          = true
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
    }
    docker {
        docker.enabled          = true
        conda.enabled           = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
        docker.runOptions       = '-u $(id -u):$(id -g)'
    }
    apptainer {
        apptainer.enabled       = true
        apptainer.autoMounts    = true
        conda.enabled           = false
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
    }
}

manifest {
    name            = 'nf-WGS-QC'
    contributors    = [
        [
            name: 'Edoardo Giacopuzzi',
            affiliation: 'Human Technopole',
            github: '@edg1983',
            contribution: ['author'],
            orcid: 'xxxx'
        ]
    ]
    homePage        = 'xxxxxx'
    description     = """Whole genome sequencing quality control pipeline."""
    mainScript      = 'main.nf'
    defaultBranch   = 'main'
    nextflowVersion = '!>=25.10.4'
    version         = '1.0.0'
}

// Nextflow plugins
plugins {
    id 'nf-schema@2.7.2' // Validation of pipeline parameters and creation of an input channel from a sample sheet
}
