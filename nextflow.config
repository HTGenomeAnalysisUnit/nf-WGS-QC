cleanup = true

params {
    outdir = 'QC'
    project_id = 'project'
    project_metadata = null //tsv file containing internal ids, external ids and sex
    report_file     = "${launchDir}/pipeline_report.html"
    bamfiles        = null //bam manifest file: sample, bam
    fastp_json      = null //path to fastp json results
    samblaster_log  = null //path to samblaster logs
    vcffiles        = null //vcf manifest file: sample, vcf
    vcf_index_type  = 'csi' //csi or tbi
    mode            = 'WGS' //WGS or WES
    ped_file        = null
    genome          = 'genome.fasta' //a .fai file must exist in the same location
    regions         = ''
    somalier_vars   = '' //VCF of somalier reference variants
    somalier_labels = '' //ancestry labels for 1kg sample 
    somalier_1kgdata = '' //path to a folder containing .somalier files for the 1000G data
    max_local_processes = 4
    make_summary = true
    run_multiqc = true
}

singularity {
  enabled = true
  autoMounts = true
  cacheDir = "/project/alfredo/singularity"
}

tower {
  enabled = true
  accessToken = 'eyJ0aWQiOiA0NjQ2fS4yMDg5ZWU1YWY2OWI4ZDQxYmJmZGE5YjI0ZWNhOGQ0ZWQyNzI5MTQy'
  workspaceId = '24886375073074'
}

profiles {
    ht_cluster {
        workDir = "/scratch/$USER/nf-work"
        executor {
            name = 'slurm'
            queueSize = 500
            pollInterval = '5sec'
            queue = 'cpuq'
        }
        process {
            errorStrategy = 'retry'
            maxRetries = 5
            //DEFINE RESOURCES
            withLabel: small_on_local {
                executor = 'local'
                maxForks = params.max_local_processes
            }
            withName: 'BCFTOOLS_INDEX' {
                cpus = 1
                memory = 1.GB
            }
            withName: 'RUN_ALIGNEMENTS_QC:COMPUTE_READSTATS' {
                cpus = 1
                memory = 24.GB
            }
            withName: 'RUN_ALIGNEMENTS_QC:COUNT_BASES' {
                cpus = 1
                memory = 1.GB
            }
            withName: 'RUN_ALIGNEMENTS_QC:COVERAGE' {
                cpus = 8
                memory = 4.GB
            }
            withName: 'RUN_ALIGNEMENTS_QC:SAMTOOLS_STATS' {
                cpus = 8
                memory = 1.GB
            }
            withName: 'RUN_ALIGNEMENTS_QC:SOMALIER_EXTRACT' {
                cpus = 1
                memory = 1.GB
            }
            withName: 'RUN_VARIANTS_QC:BCFTOOLS_IDX_STATS' {
                cpus = 1
                memory = 1.GB
            }
            withName: 'RUN_VARIANTS_QC:BCFTOOLS_STATS' {
                cpus = 2
                memory = 1.GB
            }
            withName: 'RUN_VARIANTS_QC:VCF_CONTAMINATION:ANNOTATE_AF' {
                cpus = 1
                memory = 1.GB
            }
            withName: 'RUN_VARIANTS_QC:VCF_CONTAMINATION:BCFTOOLS_FILTER_NORM' {
                cpus = 1
                memory = 1.GB
            }
            withName: 'RUN_VARIANTS_QC:VCF_CONTAMINATION:COMPUTE_CHARR' {
                cpus = 1
                memory = 1.GB
            }
            withName: 'SAMTOOLS_INDEX' {
                cpus = 8
                memory = 1.GB
            }
            withName: 'MAKE_REPORTS:MAKE_REPORTS_WF:MAKE_PED' {
                cpus = 1
                memory = 1.GB
            }
            withName: 'MAKE_REPORTS:MAKE_REPORTS_WF:PREPARE_SUMMARY' {
                cpus = 1
                memory = 8.GB
            }
            withName: 'MAKE_REPORTS:MAKE_REPORTS_WF:SOMALIER_ANCESTRY' {
                cpus = 1
                memory = 4.GB
            }
            withName: 'MAKE_REPORTS:MAKE_REPORTS_WF:SOMALIER_RELATE' {
                cpus = 1
                memory = 8.GB
            }
            //DEFINE MODULES and CONTAINERS
            withName: GET_SAMPLE_ID_BAM {
                module = 'samtools/1.15'
            }
            withName: GET_BAM_MANIFEST {
                module = 'samtools/1.15'
            }
            withName: 'SAMTOOLS.*' {
                module = 'samtools/1.15'
            }
            withName: 'COUNT_BASES' {
                module = 'samtools/1.15'
            }
            withName: 'SOMALIER.*' {
                module = 'somalier'
            }
            withName: COVERAGE {
                module = 'mosdepth:htslib-tools/1.14'
            }
            withName: MULTIQC {
                container = "${singularity.cacheDir}/multiqc_v1.12.sif"
            }
            withName: 'QC_RMD_SMALLVARS' {
                container = "${singularity.cacheDir}/vcf_qc_report_v1.sif"
            }
            withName: PREPARE_SUMMARY {
                module = 'R/4.1.0'
            }
            withName: 'BCFTOOLS.*' {
                module = 'bcftools/1.15.1'
            }
            withName: ANNOTATE_AF {
                module = 'htslib-tools/1.14'
            } 
            withName: 'MAKE_PED' {
                conda = '/project/alfredo/conda_envs/pythonenv_latest'
            }
        }
    }
}
