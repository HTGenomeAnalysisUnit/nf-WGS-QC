nextflow_process {

    name "Test Process COMPUTE_CHARR"
    script "../main.nf"
    process "COMPUTE_CHARR"

    tag "modules"
    tag "modules_local"
    tag "computecharr"

    test("dummy_sample - vcf_gz") {

        when {
            process {
                """
                input[0] = [
                    [ id:'test_sample' ],
                    file("${projectDir}/modules/local/computecharr/tests/data/test.vcf.gz", checkIfExists: true),
                    file("${projectDir}/modules/local/computecharr/tests/data/test.vcf.gz.tbi", checkIfExists: true)
                ]
                input[1] = 'AF'
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert path(process.out.charr_stats.get(0).get(1)).exists() },
                { assert path(process.out.charr_stats.get(0).get(1)).readLines().size() >= 2 },
                { assert process.out.findAll { key, val -> key.startsWith('versions') }.size() >= 1 }
            )
        }
    }

    test("dummy_sample - vcf_gz - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id:'test_sample' ],
                    file("${projectDir}/modules/local/computecharr/tests/data/test.vcf.gz", checkIfExists: true),
                    file("${projectDir}/modules/local/computecharr/tests/data/test.vcf.gz.tbi", checkIfExists: true)
                ]
                input[1] = 'AF'
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert path(process.out.charr_stats.get(0).get(1)).exists() }
            )
        }
    }
}
