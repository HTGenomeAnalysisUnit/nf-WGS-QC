nextflow_process {

    name "Test Process QUICK_READS_STATS"
    script "../main.nf"
    process "QUICK_READS_STATS"

    tag "modules"
    tag "modules_local"
    tag "qrs"

    test("dummy_sample - bam") {

        when {
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    file("${projectDir}/modules/local/qrs/tests/data/test.bam", checkIfExists: true),
                    file("${projectDir}/modules/local/qrs/tests/data/test.bam.bai", checkIfExists: true)
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert path(process.out.per_sample_run.get(0).get(1)).readLines().size() >= 2 },
                { assert path(process.out.rundetails.get(0).get(1)).readLines().size() >= 2 },
                { assert path(process.out.read_stats.get(0).get(1)).readLines().size() >= 2 },
                { assert process.out.versions_qrs.size() == 1 }
            )
        }
    }

    test("dummy_sample - bam - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    file("${projectDir}/modules/local/qrs/tests/data/test.bam", checkIfExists: true),
                    file("${projectDir}/modules/local/qrs/tests/data/test.bam.bai", checkIfExists: true)
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert path(process.out.per_sample_run.get(0).get(1)).exists() },
                { assert path(process.out.rundetails.get(0).get(1)).exists() },
                { assert path(process.out.read_stats.get(0).get(1)).exists() }
            )
        }
    }
}
