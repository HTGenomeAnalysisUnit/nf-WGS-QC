nextflow_process {

    name "Test Process SUMMARISE_ALIGN_QC"
    script "../main.nf"
    process "SUMMARISE_ALIGN_QC"

    tag "modules"
    tag "modules_local"
    tag "summarisealignqc"

    test("dummy_cohort - align_qc") {

        when {
            process {
                """
                def dataDir = file("${projectDir}/modules/local/summarisealignqc/tests/data")
                def mosdepthManifest = file("${outputDir}/mosdepth_inputs.tsv")
                mosdepthManifest.text = "id\\tbam_sample_id\\toutput_file\\n" +
                    "sample1\\tS1\\t\${dataDir}/S1.mosdepth.summary.txt\\n" +
                    "sample1\\tS1\\t\${dataDir}/S1.mosdepth.global.dist.txt\\n"

                def idxstatsManifest = file("${outputDir}/samtools_idxstats_inputs.tsv")
                idxstatsManifest.text = "id\\tbam_sample_id\\toutput_file\\n" +
                    "sample1\\tS1\\t\${dataDir}/S1.idxstats\\n"

                def statsManifest = file("${outputDir}/samtools_stats_inputs.tsv")
                statsManifest.text = "id\\tbam_sample_id\\toutput_file\\n" +
                    "sample1\\tS1\\t\${dataDir}/S1.stats\\n"

                def verifybamidManifest = file("${outputDir}/verifybamid_inputs.tsv")
                verifybamidManifest.text = "id\\tbam_sample_id\\toutput_file\\n" +
                    "sample1\\tS1\\t\${dataDir}/S1.selfSM\\n"

                def qrsManifest = file("${outputDir}/qrs_inputs.tsv")
                qrsManifest.text = "id\\tbam_sample_id\\toutput_file\\n" +
                    "sample1\\tS1\\t\${dataDir}/S1.per_sample_run.tsv\\n" +
                    "sample1\\tS1\\t\${dataDir}/S1.read_stats.tsv\\n"

                input[0]  = 'test_project'
                input[1]  = '10,20,30'
                input[2]  = '30'
                input[3]  = file("${projectDir}/modules/local/summarisealignqc/tests/data/align_qc_flags.yml", checkIfExists: true)
                input[4]  = file("${projectDir}/modules/local/summarisealignqc/tests/data/somalier_ancestry.tsv", checkIfExists: true)
                input[5]  = file("${projectDir}/modules/local/summarisealignqc/tests/data/somalier_pairs.tsv", checkIfExists: true)
                input[6]  = file("${projectDir}/modules/local/summarisealignqc/tests/data/somalier_samples.tsv", checkIfExists: true)
                input[7]  = mosdepthManifest
                input[8]  = idxstatsManifest
                input[9]  = statsManifest
                input[10] = verifybamidManifest
                input[11] = qrsManifest
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert path(process.out.qc_report_tsv.get(0)).readLines().size() == 3 },
                { assert path(process.out.qc_report_json.get(0)).text.contains('"sample1"') },
                { assert path(process.out.qc_flags.get(0)).readLines()[1].contains('\tPASS\t') },
                { assert path(process.out.qc_criteria.get(0)).readLines().size() == 4 },
                { assert path(process.out.datavzrd_yml.get(0)).text.contains('qc_metrics') },
                { assert process.out.versions_summarisealignqc.size() == 1 }
            )
        }
    }

    test("dummy_cohort - align_qc - stub") {

        options "-stub"

        when {
            process {
                """
                input[0]  = 'test_project'
                input[1]  = '10,20,30'
                input[2]  = '30'
                input[3]  = file("${projectDir}/modules/local/summarisealignqc/tests/data/align_qc_flags.yml", checkIfExists: true)
                input[4]  = file("${projectDir}/modules/local/summarisealignqc/tests/data/somalier_ancestry.tsv", checkIfExists: true)
                input[5]  = file("${projectDir}/modules/local/summarisealignqc/tests/data/somalier_pairs.tsv", checkIfExists: true)
                input[6]  = file("${projectDir}/modules/local/summarisealignqc/tests/data/somalier_samples.tsv", checkIfExists: true)
                input[7]  = file("${projectDir}/modules/local/summarisealignqc/tests/data/S1.mosdepth.summary.txt", checkIfExists: true)
                input[8]  = file("${projectDir}/modules/local/summarisealignqc/tests/data/S1.idxstats", checkIfExists: true)
                input[9]  = file("${projectDir}/modules/local/summarisealignqc/tests/data/S1.stats", checkIfExists: true)
                input[10] = file("${projectDir}/modules/local/summarisealignqc/tests/data/S1.selfSM", checkIfExists: true)
                input[11] = file("${projectDir}/modules/local/summarisealignqc/tests/data/S1.read_stats.tsv", checkIfExists: true)
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert path(process.out.qc_report_tsv.get(0)).exists() },
                { assert path(process.out.qc_report_json.get(0)).exists() },
                { assert path(process.out.qc_flags.get(0)).exists() },
                { assert path(process.out.qc_criteria.get(0)).exists() },
                { assert path(process.out.datavzrd_yml.get(0)).exists() }
            )
        }
    }
}
