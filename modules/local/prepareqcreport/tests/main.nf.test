nextflow_process {

    name "Test Process PREPARE_QC_REPORT"
    script "../main.nf"
    process "PREPARE_QC_REPORT"

    tag "modules"
    tag "modules_local"
    tag "prepareqcreport"

    test("dummy_project - qc_report") {

        when {
            process {
                """
                input[0] = 'test_project'
                input[1] = file("${projectDir}/modules/local/prepareqcreport/tests/data/align.qc_align_datavzrd.yml", checkIfExists: true)
                input[2] = file("${projectDir}/modules/local/prepareqcreport/tests/data/align.tsv", checkIfExists: true)
                input[3] = file("${projectDir}/modules/local/prepareqcreport/tests/data/align.qc_flags.tsv", checkIfExists: true)
                input[4] = file("${projectDir}/modules/local/prepareqcreport/tests/data/align.qc_criteria.tsv", checkIfExists: true)
                input[5] = file("${projectDir}/modules/local/prepareqcreport/tests/data/var.qc_var_datavzrd.yml", checkIfExists: true)
                input[6] = file("${projectDir}/modules/local/prepareqcreport/tests/data/var.tsv", checkIfExists: true)
                input[7] = file("${projectDir}/modules/local/prepareqcreport/tests/data/var.qc_flags.tsv", checkIfExists: true)
                input[8] = file("${projectDir}/modules/local/prepareqcreport/tests/data/var.qc_criteria.tsv", checkIfExists: true)
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert path(process.out.qc_summary_tsv.get(0)).readLines().size() == 4 },
                { assert path(process.out.flags_summary_tsv.get(0)).readLines().size() == 9 },
                { assert path(process.out.flags_tsv.get(0)).readLines().size() == 3 },
                { assert path(process.out.report_js.get(0)).exists() },
                { assert path(process.out.datavzrd_yml.get(0)).text.contains('default-view: 01_project_qc_summary') },
                { assert process.out.versions_prepareqcreport.size() == 1 }
            )
        }
    }

    test("dummy_project - qc_report - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = 'test_project'
                input[1] = file("${projectDir}/modules/local/prepareqcreport/tests/data/align.qc_align_datavzrd.yml", checkIfExists: true)
                input[2] = file("${projectDir}/modules/local/prepareqcreport/tests/data/align.tsv", checkIfExists: true)
                input[3] = file("${projectDir}/modules/local/prepareqcreport/tests/data/align.qc_flags.tsv", checkIfExists: true)
                input[4] = file("${projectDir}/modules/local/prepareqcreport/tests/data/align.qc_criteria.tsv", checkIfExists: true)
                input[5] = file("${projectDir}/modules/local/prepareqcreport/tests/data/var.qc_var_datavzrd.yml", checkIfExists: true)
                input[6] = file("${projectDir}/modules/local/prepareqcreport/tests/data/var.tsv", checkIfExists: true)
                input[7] = file("${projectDir}/modules/local/prepareqcreport/tests/data/var.qc_flags.tsv", checkIfExists: true)
                input[8] = file("${projectDir}/modules/local/prepareqcreport/tests/data/var.qc_criteria.tsv", checkIfExists: true)
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }
}
