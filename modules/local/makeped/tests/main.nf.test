nextflow_process {

    name "Test Process MAKE_PED"
    script "../main.nf"
    process "MAKE_PED"

    tag "modules"
    tag "modules_local"
    tag "makeped"

    test("manifest - ped") {

        when {
            process {
                """
                input[0] = file("${projectDir}/modules/local/makeped/tests/data/manifest.tsv", checkIfExists: true)
                input[1] = 'test_project'
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert path(process.out.ped_file.get(0)).readLines() == [
                    'BAM_1\tBAM_1\t0\t0\t1\t0',
                    'BAM_2\tBAM_2\t0\t0\t2\t0',
                    'BAM_3\tBAM_3\t0\t0\t-9\t0'
                ] },
                { assert process.out.versions_makeped.size() == 1 }
            )
        }
    }

    test("manifest - ped - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = file("${projectDir}/modules/local/makeped/tests/data/manifest.tsv", checkIfExists: true)
                input[1] = 'test_project'
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }
}
