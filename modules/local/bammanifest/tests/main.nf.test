nextflow_process {

    name "Test Process BAM_MANIFEST"
    script "../main.nf"
    process "BAM_MANIFEST"

    tag "modules"
    tag "modules_local"
    tag "bammanifest"

    test("homo_sapiens - bam") {

        when {
            params {
                project_id = 'test_project'
            }
            process {
                """
                input[0] = [
                    ['sample1'],
                    [file(params.modules_testdata_base_path + 'genomics/homo_sapiens/illumina/bam/test.paired_end.sorted.bam', checkIfExists: true)],
                    [file(params.modules_testdata_base_path + 'genomics/homo_sapiens/illumina/bam/test.paired_end.sorted.bam.bai', checkIfExists: true)]
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert path(process.out.bam_manifest.get(0)).readLines()[0] == 'user_sampleid\tbam_sampleid\tfile_date\tfile_path' },
                { assert path(process.out.bam_manifest.get(0)).readLines().size() == 2 },
                { assert path(process.out.sample_to_user_map.get(0)).readLines()[0] == 'user_sampleid\tbam_sampleid' },
                { assert path(process.out.sample_to_user_map.get(0)).readLines()[1].startsWith('sample1\t') },
                { assert process.out.versions_bammanifest.size() == 1 }
            )
        }
    }

    test("homo_sapiens - bam - stub") {

        options "-stub"

        when {
            params {
                project_id = 'test_project'
            }
            process {
                """
                input[0] = [
                    ['sample1'],
                    [file(params.modules_testdata_base_path + 'genomics/homo_sapiens/illumina/bam/test.paired_end.sorted.bam', checkIfExists: true)],
                    [file(params.modules_testdata_base_path + 'genomics/homo_sapiens/illumina/bam/test.paired_end.sorted.bam.bai', checkIfExists: true)]
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert path(process.out.bam_manifest.get(0)).exists() },
                { assert path(process.out.sample_to_user_map.get(0)).exists() }
            )
        }
    }
}
